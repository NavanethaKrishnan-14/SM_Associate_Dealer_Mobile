# Public API origin. Keep the /api/v1 suffix.
EXPO_PUBLIC_API_BASE_URL=https://sm-associate-dealer-backend-sand.vercel.app/api/v1

# Public OAuth client/app IDs only. Never put provider secrets in the mobile app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Optional override; by default the app uses the smassociate:// redirect scheme.
EXPO_PUBLIC_OAUTH_REDIRECT_URI=
